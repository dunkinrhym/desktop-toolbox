<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundlePackageType</key>
        <string>APPL</string>
        <key>CFBundleName</key>
        <string>{{.Info.ProductName}}</string>
        <key>CFBundleDisplayName</key>
        <string>{{.Info.ProductName}}</string>
        <key>CFBundleExecutable</key>
        <string>{{.OutputFilename}}</string>
        <key>CFBundleIdentifier</key>
        <string>com.hark.desktoptoolbox</string>
        <key>CFBundleVersion</key>
        <string>{{.Info.ProductVersion}}</string>
        <key>CFBundleShortVersionString</key>
        <string>{{.Info.ProductVersion}}</string>
        <key>CFBundleGetInfoString</key>
        <string>{{.Info.Comments}}</string>
        <key>CFBundleIconFile</key>
        <string>iconfile</string>
        <key>CFBundleDevelopmentRegion</key>
        <string>zh_CN</string>
        <key>CFBundleAllowMixedLocalizations</key>
        <true/>
        <key>LSApplicationCategoryType</key>
        <string>public.app-category.productivity</string>
        <key>LSMinimumSystemVersion</key>
        <string>12.0</string>
        <key>LSUIElement</key>
        <false/>
        <key>NSHighResolutionCapable</key>
        <true/>
        <key>NSSupportsAutomaticGraphicsSwitching</key>
        <true/>
        <key>NSHumanReadableCopyright</key>
        <string>{{.Info.Copyright}}</string>
        <key>NSMicrophoneUsageDescription</key>
        <string>录屏时如果选择了麦克风，需要使用麦克风录制声音。</string>
        <key>NSScreenCaptureUsageDescription</key>
        <string>截图和录屏需要读取屏幕内容。</string>
        <key>NSDesktopFolderUsageDescription</key>
        <string>截图和录屏默认保存到桌面；文件搜索也会查找桌面上的文件。</string>
        <key>NSDocumentsFolderUsageDescription</key>
        <string>文件搜索与格式转换需要读取“文稿”文件夹中的文件。</string>
        <key>NSDownloadsFolderUsageDescription</key>
        <string>文件搜索与格式转换需要读取“下载”文件夹中的文件。</string>
        <key>NSRemovableVolumesUsageDescription</key>
        <string>文件搜索需要读取 U 盘、移动硬盘中的文件。</string>
        <key>NSNetworkVolumesUsageDescription</key>
        <string>文件搜索需要读取网络磁盘中的文件。</string>
    </dict>
</plist>
